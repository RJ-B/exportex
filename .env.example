APP_NAME="Exportex"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Prague

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokálně stačí SQLite. Na serveru portál .env založí sám s MariaDB
# a náhodným heslem – do repa se nikdy nedává.
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pošta jde přes Poštu (posta.simren.cz) – Administrace → Pošta → Propojit s poštou.
# Propojení zařídí portál sám (php artisan posta:z-portalu, klíče na stdin). Záloha pro ruční
# nasazení – platí, jen když v nastavení propojení není (token a tajemství nikdy do gitu):
# POSTA_TOKEN=
# POSTA_WEBHOOK_TAJEMSTVI=
# POSTA_OD=
# Bez propojení platí tohle (log = maily se jen zapíšou do logu).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Doplněk Platby (docs/platby.md) – jen když je zapnutý v config/sablona.php.
# Lokálně simulace (tlačítka Zaplatit / Zamítnout). Na testu i na produkci zakládá
# testovací bránu Sim&Ren (Mo.one test) portál – údaje nikdy do repa.
PLATBY_SIMULACE=true
# PLATBY_TEST_MOONE_CLIENT_ID=
# PLATBY_TEST_MOONE_CLIENT_SECRET=
